# Line endings, decided here rather than by whoever cloned it.
#
# Everything text is LF in the repository and LF in the working tree. Without this, a Windows clone
# converts on checkout and the next `git status` reports every file as modified when nothing was
# touched - which is noise for a contributor and hides real changes in a diff.

* text=auto eol=lf

*.lua    text eol=lf
*.md     text eol=lf
*.py     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.sql    text eol=lf
*.cfg    text eol=lf

*.png    binary
*.jpg    binary
*.webp   binary
